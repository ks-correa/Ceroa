# Supabase Cloud: completar desde Connect (Direct o Session Pooler).
# No incluir usuario ni contrasena dentro de DB_URL. Ver docs/SUPABASE.md.
SPRING_PROFILES_ACTIVE=supabase
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=ceroa
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# n8n: crear credenciales por usuario desde Perfil -> Automatizaciones.
# No necesita DB_PASSWORD ni claves Supabase. Ver docs/N8N.md.

# Backend
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
SESSION_DAYS=30
SESSION_SECURE_COOKIE=false

# Correo de recuperación (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# OAuth / OpenID Connect (registrar exactamente los callbacks descritos en EP02.md)
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# UUID del tenant Entra autorizado; no usar common/organizations.
MICROSOFT_TENANT_ID=

# Integraciones previstas para fases posteriores (sin valores reales)
# Asistente web RA-N8N-001. Clave aleatoria >=32 caracteres compartida solo
# entre backend y credencial Header Auth de n8n (X-Ceroa-Assistant).
ASSISTANT_ENABLED=false
ASSISTANT_WEBHOOK_URL=http://n8n:5678/webhook/ceroa-assistant-v1
ASSISTANT_WORKER_KEY=
# RA-N8N-002: puente independiente de documentos, sin escrituras.
DOCUMENTS_ENABLED=false
DOCUMENTS_WEBHOOK_URL=http://n8n:5678/webhook/ceroa-document-draft-v1
DOCUMENTS_WORKER_KEY=
MERCADOPAGO_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
PLUS_MONTHLY_PRICE=
PLUS_YEARLY_PRICE=
PLUS_CURRENCY=COP
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
