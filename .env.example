# PostgreSQL local
POSTGRES_DB=ceroa
POSTGRES_USER=ceroa
POSTGRES_PASSWORD=ceroa_dev
POSTGRES_PORT=5432

# Backend
DB_URL=jdbc:postgresql://localhost:5432/ceroa
DB_USERNAME=ceroa
DB_PASSWORD=ceroa_dev
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
SESSION_DAYS=30
SESSION_SECURE_COOKIE=false

# Correo de recuperación (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# OAuth / OpenID Connect (registrar exactamente los callbacks descritos en EP02.md)
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# UUID del tenant Entra autorizado; no usar common/organizations.
MICROSOFT_TENANT_ID=

# Integraciones previstas para fases posteriores (sin valores reales)
MERCADOPAGO_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
