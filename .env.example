# Supabase Cloud: completar desde Connect (Direct o Session Pooler).
# Obligatorio: URL JDBC, usuario y clave separados; Supabase remoto existente.
SPRING_PROFILES_ACTIVE=supabase
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=ceroa
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Backend
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
SESSION_DAYS=30
SESSION_SECURE_COOKIE=false

# Correo de recuperación (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# OAuth opcional: callbacks /login/oauth2/code/google y /login/oauth2/code/microsoft.
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# UUID del tenant Entra autorizado; no usar common/organizations.
MICROSOFT_TENANT_ID=

# Integraciones opcionales; habilitar solo despues de configurar sus credenciales.
# Asistente web RA-N8N-001. Clave aleatoria >=32 caracteres compartida solo
# entre backend y credencial Header Auth de n8n (X-Ceroa-Assistant).
ASSISTANT_ENABLED=false
ASSISTANT_WEBHOOK_URL=http://n8n:5678/webhook/ceroa-assistant-hybrid-v1
ASSISTANT_WORKER_KEY=
# Credencial interna independiente para esta integracion.
DOCUMENTS_ENABLED=false
DOCUMENTS_WEBHOOK_URL=http://n8n:5678/webhook/ceroa-document-draft-v1
DOCUMENTS_WORKER_KEY=
# Credencial interna independiente para esta integracion.
REMINDERS_ENABLED=false
REMINDERS_WORKER_KEY=
SENTINEL_ENABLED=false
SENTINEL_WORKER_KEY=
# Credencial interna independiente para esta integracion.
RAG_ENABLED=false
RAG_DB_URL=
RAG_DB_USERNAME=
RAG_DB_PASSWORD=
# Solo para instalación/indexación administrativa; nunca usar el usuario financiero.
RAG_INDEX_USERNAME=
RAG_INDEX_PASSWORD=
RAG_EMBEDDING_WEBHOOK_URL=http://n8n:5678/webhook/ceroa-rag-embedding-v1
RAG_WORKER_KEY=
MERCADOPAGO_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
PLUS_MONTHLY_PRICE=
PLUS_YEARLY_PRICE=
PLUS_CURRENCY=COP
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Private financial document library (disabled until provisioning and verification).
DOCUMENT_LIBRARY_ENABLED=false
# Internal authenticated n8n OCR webhook; reuses the Gemini credential already installed in n8n.
# Example URL: http://n8n:5678/webhook/ceroa-library-ocr-v1
DOCUMENT_LIBRARY_OCR_URL=
# Internal webhook secret (not a Gemini API key); must match the n8n OCR header credential.
DOCUMENT_LIBRARY_OCR_KEY=
DOCUMENT_LIBRARY_WORKER_KEY=
DOCUMENT_LIBRARY_STORAGE_URL=
DOCUMENT_LIBRARY_STORAGE_KEY=
DOCUMENT_LIBRARY_BUCKET=financial-documents
DOCUMENT_LIBRARY_INGESTION_WEBHOOK_URL=http://n8n:5678/webhook/ceroa-library-ingest-v1
# Workspace opcional. Sheets permanece deshabilitado.
WORKSPACE_WORKER_KEY=
WORKSPACE_GMAIL_ENABLED=false
WORKSPACE_SHEETS_ENABLED=false
WORKSPACE_CALENDAR_ENABLED=false
WORKSPACE_CALENDAR_URL=http://n8n:5678/webhook/ceroa-google-calendar
ASSISTANT_PROVIDER_LIMITS_ENABLED=true
ASSISTANT_PROVIDER_CALLS_PER_MINUTE=15
# Opt-in: this uses worst-case iterations, not measured provider requests.
ASSISTANT_ESTIMATED_MINUTE_LIMIT_ENABLED=false
ASSISTANT_PROVIDER_CONCURRENCY=1
ASSISTANT_PROVIDER_COOLDOWN_SECONDS=60

# Docker / puertos locales (obligatorio: Docker Desktop o Engine con Compose v2).
COMPOSE_PROJECT_NAME=ceroa
COMPOSE_PROFILES=
CEROA_ENV_FILE_PATH=.env
FRONTEND_PORT=3000
N8N_PORT=5678
VITE_MAIL_DRAFTS_ENABLED=true

# n8n genera su clave de cifrado en el volumen. No sustituirla ni fijar otra
# N8N_ENCRYPTION_KEY sobre un volumen existente. Se traslada con el paquete privado.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
# Opcional: aprovisionamiento inicial de Gemini y gateway RAG restringido.
GEMINI_API_KEY=
N8N_SUPABASE_GATEWAY_URL=
N8N_SUPABASE_GATEWAY_KEY=

# Google: credenciales OAuth se reconectan en n8n, nunca se publican en Git.
# COMPOSE_PROFILES=google inicia el adaptador; activar READY solo tras validar OAuth.
WORKSPACE_PROVIDER_ENABLED=false
WORKSPACE_DRAFT_URL=http://n8n:5678/webhook/ceroa-google-draft
SUPPORT_CALENDAR_ID=
WORKSPACE_DRIVE_FOLDER_ID=
WORKSPACE_SHEETS_DOCUMENT_ID=
WORKSPACE_SHEETS_TAB=

# Telegram opcional: COMPOSE_PROFILES=telegram (o google,telegram).
# Configurar Ceroa Telegram en n8n. No arrancar dos consumidores del mismo bot.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_PATH=
TELEGRAM_WEBHOOK_SECRET=

# MCP externo opcional, autenticacion Header Auth configurada en n8n.
MCP_EXTERNAL_URL=

# Solo perfil test: base aislada descartable, nunca Supabase operativo.
TEST_DB_NAME=ceroa_test
TEST_DB_USER=ceroa_test
TEST_DB_PASSWORD=
