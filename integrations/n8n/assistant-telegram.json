    },
    {
      "id": "failure",
      "name": "Explicar fallo temporal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1750,
        320
      ],
      "parameters": {
        "jsCode": "const source=$('Validar chat privado').first().json;return [{json:{send:true,chatId:source.body.chatId,answer:'No pude procesar tu consulta. Inténtalo de nuevo en un momento.'}}];"
      }
    },
    {
      "id": "split",
      "name": "Preparar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1970,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;if(!r.send||!Number.isSafeInteger(r.chatId)||r.chatId<=0||typeof r.answer!=='string')return [];\nconst items=[];let chunk='';for(const char of Array.from(r.answer)){const escaped=char.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');if(chunk.length+escaped.length>3500){items.push({json:{chatId:r.chatId,answer:chunk}});chunk='';}chunk+=escaped;}if(chunk)items.push({json:{chatId:r.chatId,answer:chunk}});return items;"
      }
    },
    {
      "id": "send",
      "name": "Responder por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2190,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.answer }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      }
    }
