      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1530,
        -100
      ],
      "parameters": {
        "jsCode": "const body={...$('Validar chat privado').first().json.body};\nconst buffer=await this.helpers.getBinaryDataBuffer(0,'data');\nif(buffer.length<12||buffer.length>4194304||buffer.subarray(0,4).toString()!=='OggS') throw new Error('Audio no válido');\nbody.audio=buffer.toString('base64');body.mime='audio/ogg';return [{json:{body}}];"
      },
      "onError": "continueErrorOutput"
    },
