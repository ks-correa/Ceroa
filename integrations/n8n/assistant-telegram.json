    {
      "id": "split",
      "name": "Preparar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1970,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;if(!r.send||!Number.isSafeInteger(r.chatId)||r.chatId<=0||typeof r.answer!=='string')return [];\nconst items=[];let chunk='';for(const char of Array.from(r.answer)){const escaped=char.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');if(chunk.length+escaped.length>3500){items.push({json:{chatId:r.chatId,answer:chunk}});chunk='';}chunk+=escaped;}if(chunk)items.push({json:{chatId:r.chatId,answer:chunk}});return items;"
      }
    },
