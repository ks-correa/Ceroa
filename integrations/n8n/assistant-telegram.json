        "jsCode": "const r=$input.first().json,a=r.attachment;if(!r.send||!Number.isSafeInteger(r.chatId)||r.chatId<=0||!a||typeof a.data!=='string'||a.data.length>11184812||!(/\\.(pdf|docx|xlsx)$/i).test(a.fileName))return [];return [{json:{chatId:r.chatId,caption:String(r.answer||'Documento privado').slice(0,1000)},binary:{data:{data:a.data,mimeType:a.mime,fileName:a.fileName}}}];"
