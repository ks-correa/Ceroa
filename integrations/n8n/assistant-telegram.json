    {
      "id": "normalize",
      "name": "Validar chat privado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const u=$input.first().json,m=u.message;\nif(!m||m.chat?.type!=='private'||m.from?.is_bot||!Number.isSafeInteger(m.from?.id)||m.from.id<=0||m.chat.id!==m.from.id||!Number.isSafeInteger(u.update_id)||u.update_id<0)return [];\nconst voice=m.voice,document=m.document;\nconst body={updateId:u.update_id,senderId:m.from.id,chatId:m.chat.id,privateChat:true,text:document?(m.caption||''):(m.text||''),audio:'',mime:'',document:document?{fileName:document.file_name||'',mime:document.mime_type||'',data:''}:null};\nconst invalid=body.text.length>2000||voice&&(voice.duration>60||!voice.file_size||voice.file_size>4194304||voice.mime_type!=='audio/ogg')||document&&(!Number.isSafeInteger(document.file_size)||document.file_size<1||document.file_size>8388608||!document.file_id||!document.file_name||document.file_name.length>160||!(/\\.(pdf|docx|xlsx)$/i).test(document.file_name))||!body.text&&!voice&&!document||!!voice&&!!document;\nreturn [{json:{body,isAudio:Boolean(voice&&!invalid),isDocument:Boolean(document&&!invalid),hasFile:Boolean((voice||document)&&!invalid),invalid:Boolean(invalid),fileId:document?.file_id||voice?.file_id||''}}];"
      }
    },
