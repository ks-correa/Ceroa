      "parameters": {
        "jsCode": "const source=$('Validar chat privado').first().json;const buffer=await this.helpers.getBinaryDataBuffer(0,'data');if(buffer.length<1||buffer.length>8388608)throw new Error('Archivo fuera de límites');const body={...source.body,document:{...source.body.document,data:buffer.toString('base64')}};return [{json:{body}}];"
