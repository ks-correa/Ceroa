      "parameters": {
        "method": "POST",
        "url": "http://backend:8080/api/v1/assistant-tools/telegram/delivery",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({token:$json.deliveryToken}) }}",
