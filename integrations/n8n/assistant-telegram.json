  "active": false,
  "nodes": [
    {
      "id": "REPLACE_WITH_PRIVATE_RANDOM_ID",
      "name": "Recibir Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "webhookId": "REPLACE_WITH_PRIVATE_RANDOM_WEBHOOK_ID"
    },
    {
      "id": "normalize",
      "name": "Validar chat privado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const u=$input.first().json,m=u.message;\nif(!m||m.chat?.type!=='private'||m.from?.is_bot||!Number.isSafeInteger(m.from?.id)||m.from.id<=0||m.chat.id!==m.from.id||!Number.isSafeInteger(u.update_id)||u.update_id<0)return [];\nconst body={updateId:u.update_id,senderId:m.from.id,chatId:m.chat.id,privateChat:true,text:m.text||'',audio:'',mime:''};\nconst voice=m.voice;\nconst invalid=body.text.length>2000||voice&&(voice.duration>60||!voice.file_size||voice.file_size>4194304||voice.mime_type!=='audio/ogg')||!body.text&&!voice;\nreturn [{json:{body,isAudio:Boolean(voice&&!invalid),invalid:Boolean(invalid),fileId:voice?.file_id||''}}];"
      }
    },
    {
      "id": "Formato permitido",
      "name": "Formato permitido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        430,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "invalid",
              "leftValue": "={{ Boolean($json.invalid) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "invalid",
      "name": "Explicar formato",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        -200
      ],
      "parameters": {
        "jsCode": "const source=$('Validar chat privado').first().json; return [{json:{send:true,chatId:source.body.chatId,answer:'Envía un texto de hasta 2.000 caracteres o una nota de voz de hasta 60 segundos y 4 MB.'}}];"
      }
    },
