    {
      "id": "unlinked",
      "name": "Indicar vinculación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1310,
        150
      ],
      "parameters": {
        "jsCode": "const a=$input.first().json; return [{json:{send:a.chatId>0,chatId:a.chatId,answer:a.answer}}];"
      }
    },
    {
      "id": "download",
      "name": "Descargar voz autorizada",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1310,
        -100
      ],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $(\"Validar chat privado\").first().json.fileId }}",
        "download": true,
        "additionalFields": {
          "mimeType": "audio/ogg"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "audio",
      "name": "Preparar voz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1530,
        -100
      ],
      "parameters": {
        "jsCode": "const body={...$('Validar chat privado').first().json.body};\nconst buffer=await this.helpers.getBinaryDataBuffer(0,'data');\nif(buffer.length<12||buffer.length>4194304||buffer.subarray(0,4).toString()!=='OggS') throw new Error('Audio no válido');\nbody.audio=buffer.toString('base64');body.mime='audio/ogg';return [{json:{body}}];"
      },
      "onError": "continueErrorOutput"
    },
