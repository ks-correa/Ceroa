{
  "id": "ceroaHybridQuery20",
  "name": "Ceroa - Asistente - Orquestador multiagente",
  "active": false,
  "nodes": [
    {
      "id": "entry",
      "name": "Recibir consulta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ceroa-assistant-hybrid-v1",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
