    {
      "id": "delegate-FINANCIAL",
      "name": "Delegar a Financiero",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "parameters": {
        "description": "Interpreta obligaciones, saldos, tasas normalizadas, vencimientos, pagos registrados, capacidad, estrategia activa, comparación de estrategias y progreso usando datos financieros actuales. profile.availableMoney es presupuesto asignado, no ingreso menos gastos; usa incomeAfterExpenses y unallocatedAfterDebtBudget para esas diferencias. summary contiene indicadores derivados por el backend. Consulta todas las páginas antes de afirmar extremos o totales. Distingue EA, MV y NAMV, tasas desconocidas y sin interés. Las proyecciones solo existen si el backend las devuelve. Usa FACT_ANALYSIS para comparaciones documentales tipadas; si falta evidencia solicita recuperación al orquestador mediante missingData, sin ampliar tus herramientas. Calcular con evidencia solo admite referencias numéricas autorizadas. La simulación es hipotética y exige permisos vigentes; nunca confirma resultados futuros. No uses conocimiento general sin respaldo documental compartido.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "ceroaFinancialAgent30",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "requestId": "={{ $(\"Preparar texto\").first().json.requestId }}",
            "task": "={{ $fromAI(\"task\",\"Tarea concreta y mínima para este especialista\", \"string\") }}",
            "evidenceRefs": "={{ $fromAI(\"evidenceRefs\",\"Authorized fID or dID keys separated by commas; empty string when absent\", \"string\", \"\").split(\",\").map(x=>x.trim()).filter(Boolean) }}",
            "context": "={{ {year:$(\"Preparar texto\").first().json.year,month:$(\"Preparar texto\").first().json.month,selectedDocument:$(\"Preparar texto\").first().json.selectedDocument} }}"
          },
          "matchingColumns": [],
          "schema": [
