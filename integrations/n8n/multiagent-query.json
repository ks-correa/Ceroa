      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1450,
        270
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"answer\",\"mode\",\"sources\"],\"properties\":{\"answer\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"enum\":[\"documentary\",\"personal\",\"mixed\"]},\"sources\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^d[1-8]$\"},\"maxItems\":8,\"uniqueItems\":true}}}",
        "autoFix": false
      }
    },
    {
      "id": "check",
      "name": "Validar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        0
      ],
      "parameters": {
        "jsCode": "let output=$input.first().json.output;if(typeof output==='string')output=JSON.parse(output);if(!output||typeof output.answer!=='string'||!output.answer.trim()||output.answer.length>12000||!['documentary','personal','mixed'].includes(output.mode)||!Array.isArray(output.sources))throw new Error('Contrato RAG inválido');const input=$('Preparar texto').first().json;return [{json:{requestId:input.requestId,answer:output.answer,transcript:input.message,mode:output.mode,sources:output.sources}}];"
      },
      "onError": "continueErrorOutput"
    },
