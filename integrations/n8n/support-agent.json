    {
      "id": "parser",
      "name": "Contrato del especialista",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"schemaVersion\",\"role\",\"status\",\"answer\",\"evidenceRefs\",\"sources\",\"coverage\",\"missingData\",\"requiresConfirmation\",\"requiresClarification\"],\"properties\":{\"schemaVersion\":{\"type\":\"string\",\"pattern\":\"^1[.]1$\"},\"role\":{\"type\":\"string\",\"pattern\":\"^SUPPORT$\"},\"status\":{\"enum\":[\"OK\",\"PARTIAL\",\"INSUFFICIENT\",\"FAILED\"]},\"answer\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":10000},\"evidenceRefs\":{\"type\":\"array\",\"maxItems\":100,\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^f[1-9][0-9]*$\"}},\"sources\":{\"type\":\"array\",\"maxItems\":8,\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^d[1-8]$\"}},\"coverage\":{\"enum\":[\"COMPLETE\",\"PARTIAL\",\"NONE\"]},\"missingData\":{\"type\":\"array\",\"maxItems\":12,\"items\":{\"type\":\"string\",\"maxLength\":200}},\"requiresConfirmation\":{\"type\":\"boolean\"},\"requiresClarification\":{\"type\":\"boolean\"}}}",
        "autoFix": false
      },
      "position": [
        880,
        360
