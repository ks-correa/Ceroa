{
  "id": "ceroaSupportAgent30",
  "name": "Ceroa - Agente Soporte",
  "active": false,
  "nodes": [
    {
      "id": "entry",
      "name": "Recibir delegación",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
