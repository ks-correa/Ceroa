        "toolDescription": "Retrieve approved Ceroa documentation only. Returns relevance-filtered chunks and dID references, or an explicit absence status. No financial data, writes, SQL or arbitrary URLs. Rewrite follow-up references into a self-contained query using conversation context.",
        "url": "={{ \"http://backend:8080/api/v1/assistant-tools/requests/\" + $(\"Recibir delegación\").first().json.requestId + \"/documents\" }}",
        "sendQuery": true,
