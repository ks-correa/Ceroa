        ]
      ]
    },
    "Contrato del especialista": {
      "ai_outputParser": [
        [
          {
            "node": "Agente Soporte",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "Agente Soporte": {
      "main": [
        [
          {
            "node": "Validar resultado en Spring Boot",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Devolver fallo recuperable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar resultado en Spring Boot": {
      "main": [
        [],
        [
          {
            "node": "Devolver fallo recuperable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar documentación aprobada": {
      "ai_tool": [
        [
          {
            "node": "Agente Soporte",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota",
    "executionTimeout": 150,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  }
}
