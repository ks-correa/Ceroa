    },
    {
      "id": "begin",
      "name": "Autorizar alcance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://backend:8080/api/v1/assistant-tools/requests/\" + $json.requestId + \"/delegations/SUPPORT/begin\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({task:$json.task,evidenceRefs:$json.evidenceRefs ?? []}) }}",
        "options": {
          "timeout": 15000
