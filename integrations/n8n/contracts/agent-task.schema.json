{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ceroa:agent-task:1.0",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","requestId","correlationId","role","task","budget"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "requestId":{"type":"string","format":"uuid","description":"Server-bound request context; never accept an LLM-supplied identity or scope."},
    "correlationId":{"type":"string","format":"uuid"},
    "role":{"enum":["ORCHESTRATOR","FINANCIAL","RAG","SUPPORT"]},
    "task":{"type":"string","minLength":1,"maxLength":2000},
    "budget":{"type":"object","additionalProperties":false,"required":["maxIterations","maxToolCalls","maxLibraryCalls","maxContextCharacters","deadlineMs"],"properties":{
      "maxIterations":{"type":"integer","minimum":2,"maximum":12},"maxToolCalls":{"type":"integer","minimum":1,"maximum":16},
      "maxLibraryCalls":{"type":"integer","minimum":0,"maximum":6},"maxContextCharacters":{"type":"integer","minimum":1000,"maximum":90000},
      "deadlineMs":{"type":"integer","minimum":1000,"maximum":150000}
    }},
    "evidenceRefs":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","pattern":"^f[1-9][0-9]*$"}}
  }
}
